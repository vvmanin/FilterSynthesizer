   "label": "Max R ratio",
   "key": "hw_ratio_*",
   "function": "_section_settings",
   "panel": "⚙ Section * — topology & component settings",
   "sidebar": false,
   "help": "Phase 3 rejects any solution whose resistor spread exceeds this — lower = far fewer solutions. The old default of 60 was below what most sections need and had to be raised by hand almost every run: an MFB band-pass alone spends ~4·Q² of spread on its core, so 60 caps it at Q ≈ 3.9 and returns nothing above that. 500 clears Q ≈ 11 and leaves the guard doing its real job — rejecting genuinely unbuildable spreads — rather than gating ordinary designs.",
   "default": "500.0",
   "step": "1.0"
  },
